; Starlantern: a small, editable native Godot prototype.
config_version=5

[application]
config/name="별등 원정기 · Starlantern"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.64, 0.76, 0.76, 1)
lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=1

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=22.0

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Actors"

[debug]
gdscript/warnings/untyped_declaration=0
